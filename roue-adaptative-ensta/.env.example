# =============================================================================
# VARIABLES D'ENVIRONNEMENT SÉCURISÉES — TECHNOLOGIE R2A ENSTA BRETAGNE
# =============================================================================
# Copiez ce fichier sous le nom ".env" sur votre PC / serveur local pour personnaliser
# les codes d'accès. NE COMMITEZ JAMAIS LE FICHIER ".env" DANS GIT (.gitignore le bloque).

# -----------------------------------------------------------------------------
# 1. CODES D'ACCÈS SERVEUR (Validés côté Node.js - Jamais exposés au navigateur)
# -----------------------------------------------------------------------------
# Code d'accès administrateur au Back-Office (verrouillage 30 s après 5 échecs)
R2A_ADMIN_PASSCODE=ENSTA2026

# Code d'accès Enseignants-Chercheurs & Référents DAJV ENSTA (Y. Argouarc'h / M. Benard)
R2A_PROFESSOR_CODE=R2A-PROF-2026

# Code d'accès réservé à l'Équipe Projet 6.1 (Magda Bihan, Mathéo Joly, Marc Bonnafoux)
R2A_TEAM_CODE=ENSTA-R2A-2026

# -----------------------------------------------------------------------------
# 2. CONFIGURATION FRONTEND OPTIONNELLE (Vite)
# -----------------------------------------------------------------------------
# En production, renseignez ces variables dans l'interface Vercel (Project Settings > Environment Variables).
VITE_ADMIN_PASSCODE=ENSTA2026
VITE_PROFESSOR_CODE=R2A-PROF-2026
VITE_TEAM_CODE=ENSTA-R2A-2026

# -----------------------------------------------------------------------------
# 3. CAMPAGNE CLOUD 24/7 (VERCEL + FIREBASE REALTIME DATABASE)
# -----------------------------------------------------------------------------
# URL de votre Realtime Database Firebase (sans slash final)
# Exemple: https://r2a-ensta-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_URL=https://votre-projet-default-rtdb.europe-west1.firebasedatabase.app

# Secret de base de données Firebase (pour lecture sécurisée du Back-Office)
# Trouvé dans : Firebase Console > Paramètres du projet > Comptes de service > Secrets de base de données
VITE_FIREBASE_SECRET=votre_secret_base_de_donnees_firebase_ici

# -----------------------------------------------------------------------------
# 4. CONFIGURATION SERVEUR LOCAL & CLOUD PC (OPTIONNEL)
# -----------------------------------------------------------------------------
# Port d'écoute du serveur local
PORT=5173

# Dossier local de stockage de la base JSON (par défaut: ./data)
# R2A_DATA_DIR=./data

